[gd_resource type="ShaderMaterial" format=3 uid="uid://by0reuid2pbbr"]

[sub_resource type="Shader" id="Shader_accents"]
code = "shader_type spatial;
render_mode diffuse_burley;

float hash21(vec2 p) {
    p = fract(p * vec2(127.1, 311.7));
    p += dot(p, p + 31.19);
    return fract(p.x * p.y);
}

void fragment() {
    vec2 uv = UV;
    float n = hash21(floor(uv * 55.0));
    float dirt = smoothstep(0.48, 0.92, n);

    vec3 yellow = vec3(1.0, 0.72, 0.04);
    vec3 cyan = vec3(0.02, 0.82, 0.88);
    vec3 pink = vec3(0.90, 0.04, 0.48);
    vec3 purple = vec3(0.38, 0.04, 0.65);

    float t = sin(uv.x * 18.0 + uv.y * 9.0) * 0.5 + 0.5;
    vec3 col = mix(yellow, cyan, t);
    col = mix(col, pink, smoothstep(0.65, 0.95, sin(uv.y * 27.0) * 0.5 + 0.5));
    col = mix(col, purple, dirt * 0.45);

    col *= mix(0.52, 1.0, 1.0 - dirt * 0.55);
    col += vec3(0.08) * smoothstep(0.82, 1.0, hash21(floor(uv * 90.0)));

    ALBEDO = col;
    ROUGHNESS = 0.9;
    METALLIC = 0.0;
}"

[resource]
resource_name = "Block Drop - Dusty Janky Accents"
render_priority = 0
shader = SubResource("Shader_accents")
