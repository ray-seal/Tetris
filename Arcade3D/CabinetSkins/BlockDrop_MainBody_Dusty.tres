[gd_resource type="ShaderMaterial" format=3 uid="uid://dkp7v0bh5ajqx"]

[sub_resource type="Shader" id="Shader_main"]
code = "shader_type spatial;
render_mode diffuse_burley;

float hash21(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

void fragment() {
    vec2 uv = UV;
    float n = hash21(floor(uv * 38.0));
    float grime = smoothstep(0.35, 0.85, n);

    vec3 dark = vec3(0.035, 0.045, 0.055);
    vec3 purple = vec3(0.20, 0.025, 0.24);
    vec3 teal = vec3(0.015, 0.16, 0.18);
    vec3 red = vec3(0.30, 0.035, 0.025);

    float band = sin(uv.y * 34.0 + uv.x * 8.0) * 0.5 + 0.5;
    vec3 bands = mix(purple, teal, band);
    bands = mix(bands, red, smoothstep(0.72, 0.95, sin(uv.x * 19.0) * 0.5 + 0.5));

    vec3 col = mix(dark, bands, 0.42);
    col *= mix(0.58, 1.0, grime);
    col += vec3(0.045) * smoothstep(0.7, 1.0, sin(uv.y * 170.0));

    ALBEDO = col;
    ROUGHNESS = 0.94;
    METALLIC = 0.0;
}"

[resource]
resource_name = "Block Drop - Dusty Janky Main Body"
render_priority = 0
shader = SubResource("Shader_main")
